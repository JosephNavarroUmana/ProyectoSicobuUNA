<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">
  <persistence-unit name="SicobuPU" transaction-type="JTA">
    <!-- Recurso JDBC creado en Payara (pool SicobuPool) -->
    <jta-data-source>jdbc/Sicobu</jta-data-source>
    <!-- Detecta automáticamente las entidades @Entity del war -->
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <!-- Sin caché compartida, para ver siempre datos frescos -->
      <property name="eclipselink.cache.shared.default" value="false"/>
    </properties>
  </persistence-unit>
</persistence>